# Fill required secrets privately before starting any stack. See docs/SECURITY_PHASE_2.md.
# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD= # Set privately
POSTGRES_DB=proctolearn_db

# Native backend: set a private DATABASE_URL. Docker constructs its internal URL.
DATABASE_URL= # Set privately

# JWT
# Generate TWO different keys: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET= # Set privately
JWT_REFRESH_SECRET= # Set privately
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD= # Set privately
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=proctolearn-evidence
# Browser-accessible MinIO origin; use an HTTPS storage domain in production.
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1

# App
API_PORT=4000
NODE_ENV=development
# Exact comma-separated origins. Production requires HTTPS; frontend and API must
# be same-site for SameSite=Lax session cookies (e.g. app.example.com/api.example.com).
FRONTEND_URL=http://localhost:3000,http://localhost:3001
# Optional exact proxy IP/CIDR allowlist; empty means do NOT trust forwarded headers.
# Set only after verifying the API peer address/topology. See docs/RELEASE_RUNBOOK.md.
TRUSTED_PROXIES=

# Service credentials (no shared defaults)
PGADMIN_DEFAULT_EMAIL=admin@proctolearn.com
PGADMIN_DEFAULT_PASSWORD= # Set privately
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD= # Set privately
N8N_ENCRYPTION_KEY= # Set privately
N8N_PUBLIC_WEBHOOK_URL=http://localhost:5678/
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_EMAIL=admin@proctolearn.com
JENKINS_ADMIN_PASSWORD= # Set privately

# OPAL / OPA tokens
OPAL_MASTER_TOKEN= # Set privately
OPAL_CLIENT_TOKEN= # Set privately
OPAL_POLICY_REPO_URL=https://github.com/AASSAA17/ProctoLearn
OPAL_POLICY_REPO_POLLING_INTERVAL=20

# n8n integration (exam submit webhook)
N8N_EXAM_SUBMIT_WEBHOOK_URL=http://localhost:5678/webhook/proctolearn/exam-submit
N8N_WEBHOOK_TOKEN= # Set privately
SMTP_FROM=no-reply@proctolearn.kz
PROCTOR_ALERT_EMAIL=proctor@test.local

# Frontend (public)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Monitoring stack
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD= # Set privately
ZABBIX_DB_PASSWORD= # Set privately
NAGIOSADMIN_USER=nagiosadmin
NAGIOSADMIN_PASS= # Set privately
# Monitoring alert delivery requires a newly rotated private bot token and chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PROM_URL=http://prometheus:9090
STATUS_INTERVAL_MINUTES=30

# Explicit opt-in for disposable demo databases only
ALLOW_DEMO_SEED=false
DEMO_ADMIN_PASSWORD= # Set privately
DEMO_TEACHER_PASSWORD= # Set privately
DEMO_STUDENT_PASSWORD= # Set privately
DEMO_PROCTOR_PASSWORD= # Set privately
DEMO_SEED_PASSWORD= # Set privately
